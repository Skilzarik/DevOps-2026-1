# Шаблон настроек контейнерного окружения.
# Рабочий файл .env.docker создаёт `make container-env` со случайными паролями.
# В git он не попадает (.gitignore), в образ тоже (.dockerignore).
APP_VERSION=1.0.0
HTTP_PORT=80
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
MIGRATOR_DB_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
