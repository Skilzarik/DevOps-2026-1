# Подключение к базе данных PostgreSQL
# Формат: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/music_store

# Секретный ключ для подписи JWT-токенов
# ВНИМАНИЕ: В продакшене используйте длинную случайную строку!
SECRET_KEY=change-me-in-production-use-long-random-string

# Алгоритм хеширования JWT
ALGORITHM=HS256

# Время жизни access-токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=30